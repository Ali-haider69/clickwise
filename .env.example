# ──────────────────────────────────────────────
# ClickWise Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# ── Contact Form (Web3Forms — free, 250 submissions/month) ──
# 1. Go to https://web3forms.com
# 2. Enter your email → get access key
WEB3FORMS_KEY=

# ── Newsletter (pick ONE provider) ──

# Option A: Beehiiv (recommended — free up to 2,500 subscribers)
# 1. Sign up at https://beehiiv.com
# 2. Settings → Integrations → API → Create API Key
# 3. Settings → Publication → Copy Publication ID
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Option B: Kit / ConvertKit (free up to 10,000 subscribers)
# 1. Sign up at https://kit.com
# 2. Settings → Advanced → API Key
# 3. Create a Form → note the Form ID
KIT_API_KEY=
KIT_FORM_ID=
